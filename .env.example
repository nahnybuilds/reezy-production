# Copy to .env.local (git-ignored) and fill in. Never commit real values.
# Supabase → Project Settings → API Keys (new projects use "publishable" and "secret" keys).

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only — bypasses RLS. Never expose to the browser, never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Sent in the User-Agent to Open Library, as they request (a site URL or contact address).
OPEN_LIBRARY_CONTACT="Reezy (https://your-domain)"
